    function openLancamentoFinanceiroModal(mode) {
      const isPagar = mode === 'pagar';
      const clients = [...(AppState.clientesContabeis || []), ...(AppState.clientesGerais || [])];

      openModal(
        isPagar ? 'Nova Despesa (Contas a Pagar)' : 'Novo Lançamento (Contas a Receber)',
        `
          <form id="fin-form" class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            ${
              isPagar
                ? `<div class="sm:col-span-2"><label class="font-semibold">Categoria</label>
                    <select name="categoria" class="w-full mt-1 px-3 py-2 rounded-xl border bg-white">
                      ${EXPENSE_CATEGORIES.map((c) => `<option>${c}</option>`).join('')}
                    </select></div>`
                : `<div class="sm:col-span-2"><label class="font-semibold">Cliente *</label>
                    <input list="fin-clients-list" name="cliente" required placeholder="Selecione ou digite o nome do cliente" class="w-full mt-1 px-3 py-2 rounded-xl border" />
                    <datalist id="fin-clients-list">${clients.map((c) => `<option value="${escapeHTML(c.nomeRazao)}"></option>`).join('')}</datalist></div>`
            }
            <div class="sm:col-span-2"><label class="font-semibold">Descrição *</label><input name="descricao" required placeholder="${isPagar ? 'Ex: Aluguel Sala Comercial' : 'Ex: Honorários Contábeis'}" class="w-full mt-1 px-3 py-2 rounded-xl border" /></div>
            <div><label class="font-semibold">Valor da Parcela (R$) *</label><input type="number" step="0.01" name="valor" required class="w-full mt-1 px-3 py-2 rounded-xl border" /></div>
            <div><label class="font-semibold">1º Vencimento *</label><input type="date" name="vencimento" required value="${new Date().toISOString().slice(0, 10)}" class="w-full mt-1 px-3 py-2 rounded-xl border" /></div>
            <div><label class="font-semibold">Quantidade de Parcelas Mensais</label><input type="number" min="1" max="60" name="parcelas" value="1" class="w-full mt-1 px-3 py-2 rounded-xl border" /></div>
          </form>
        `,
        `
          <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl bg-slate-200 text-xs font-bold cursor-pointer">Cancelar</button>
          <button type="submit" form="fin-form" class="px-4 py-2 rounded-xl bg-accent-500 text-white text-xs font-bold cursor-pointer">Gerar Lançamento(s)</button>
        `
      );

      document.getElementById('fin-form').onsubmit = (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const count = Math.max(1, Number(fd.get('parcelas') || 1));
        const baseDate = new Date(fd.get('vencimento') + 'T00:00:00');
        const valor = Number(fd.get('valor') || 0);

        for (let i = 0; i < count; i++) {
          const d = new Date(baseDate);
          d.setMonth(d.getMonth() + i);
          const iso = d.toISOString().slice(0, 10);

          if (isPagar) {
            AppState.contasPagar.unshift({
              id: generateId('CP'),
              descricao: fd.get('descricao').trim(),
              categoria: fd.get('categoria'),
              parcela: `${i + 1}/${count}`,
              vencimento: iso,
              valor,
              status: 'Pendente',
              dataPagamento: ''
            });
          } else {
            AppState.contasReceber.unshift({
              id: generateId('CR'),
              cliente: fd.get('cliente').trim(),
              descricao: fd.get('descricao').trim(),
              parcela: `${i + 1}/${count}`,
              vencimento: iso,
              valor,
              status: 'Pendente',
              dataRecebimento: ''
            });
          }
        }
        saveState();
        closeModal();
        renderRoute(mode);
        showToast(`${count} parcela(s) lançada(s) com sucesso!`);
      };
    }

    function toggleFinanceiroStatus(mode, id, newStatus) {
      const list = mode === 'pagar' ? AppState.contasPagar : AppState.contasReceber;
      const item = (list || []).find((x) => x.id === id);
      if (!item) return;
      item.status = newStatus;
      const today = new Date().toISOString().slice(0, 10);
      if (mode === 'pagar') item.dataPagamento = newStatus === 'Pago' ? today : '';
      else item.dataRecebimento = newStatus === 'Recebido' ? today : '';
      saveState();
      renderRoute(mode);
      showToast(`Status atualizado para ${newStatus}.`);
    }

    function deleteFinanceiroItem(mode, id) {
      askConfirm('Excluir Lançamento', 'Confirma a exclusão deste lançamento financeiro?', () => {
        if (mode === 'pagar') AppState.contasPagar = AppState.contasPagar.filter((x) => x.id !== id);
        else AppState.contasReceber = AppState.contasReceber.filter((x) => x.id !== id);
        saveState();
        renderRoute(mode);
        showToast('Lançamento excluído.');
      });
    }

