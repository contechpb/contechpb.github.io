    function setupAutoSync() {
      if (autoSyncTimer) clearInterval(autoSyncTimer);
      const mins = Number(AppState.config?.autoSyncMinutes || 0);
      if (mins > 0 && AppState.config?.gasUrl) {
        autoSyncTimer = setInterval(() => syncAllToGas(true), mins * 60000);
      }
    }

    async function testGasRead() {
      const url = document.getElementById('gas-url-input')?.value.trim() || AppState.config.gasUrl;
      if (!url) return showToast('Informe a URL /exec do Google Apps Script.', 'error');
      try {
        const res = await fetch(`${url}?action=test`);
        const data = await res.json();
        AppState.config.lastSyncAt = new Date().toISOString();
        AppState.config.lastSyncMessage = data.success ? `Conectado: ${data.spreadsheet || 'Planilha ativa'}` : `Erro: ${data.error}`;
        saveState();
        renderRoute('administracao');
        showToast(AppState.config.lastSyncMessage, data.success ? 'success' : 'error');
      } catch (err) {
        showToast('Falha ao conectar com a URL informada.', 'error');
      }
    }

    function mapClientToSheetRow(c) {
      return {
        ID: c.id, ID_Alterdata: c.idAlterdata, Nome_Razao_Social: c.nomeRazao, CPF: c.cpf, RG: c.rg, CNH: c.cnh,
        Titulo_Eleitor: c.tituloEleitor, Data_Nascimento: c.dataNascimento, Celular: c.celular, Email: c.email,
        CNPJ: c.cnpj, Inscricao_Estadual: c.inscricaoEstadual, Inscricao_Municipal: c.inscricaoMunicipal,
        Data_Abertura: c.dataAbertura, Regime_Tributario: c.regimeTributario, Capital_Social: c.capitalSocial,
        Producoes: (c.producoes || []).join(', '), Parcelamentos: (c.parcelamentos || []).join(', '),
        Status_EFD: c.obrigacoes?.EFD || '', Status_MIT: c.obrigacoes?.MIT || '',
        Status_DEFIS: c.obrigacoes?.DEFIS || '', Status_DASN: c.obrigacoes?.DASN || '',
        Vencimento_Certificado: c.certificadoVencimento, Senha_GOV: c.senhas?.gov || '',
        Senha_NFSe_Email: [c.senhas?.nfse, c.senhas?.email].filter(Boolean).join(' | ')
      };
    }

    function mapSheetRowToClient(r) {
      const senhasSplit = String(r.Senha_NFSe_Email || '').split('|').map((s) => s.trim());
      return {
        id: r.ID || generateId('CL'),
        idAlterdata: r.ID_Alterdata || '',
        nomeRazao: r.Nome_Razao_Social || '',
        cpf: r.CPF || '',
        rg: r.RG || '',
        cnh: r.CNH || '',
        tituloEleitor: r.Titulo_Eleitor || '',
        dataNascimento: r.Data_Nascimento || '',
        celular: r.Celular || '',
        email: r.Email || '',
        cnpj: r.CNPJ || '',
        inscricaoEstadual: r.Inscricao_Estadual || '',
        inscricaoMunicipal: r.Inscricao_Municipal || '',
        dataAbertura: r.Data_Abertura || '',
        regimeTributario: r.Regime_Tributario || 'Simples Nacional',
        capitalSocial: Number(r.Capital_Social || 0),
        producoes: r.Producoes ? String(r.Producoes).split(',').map((s) => s.trim()).filter(Boolean) : [],
        parcelamentos: r.Parcelamentos ? String(r.Parcelamentos).split(',').map((s) => s.trim()).filter(Boolean) : [],
        obrigacoes: { EFD: r.Status_EFD || 'Pendente', MIT: r.Status_MIT || 'N/A', DEFIS: r.Status_DEFIS || 'Pendente', DASN: r.Status_DASN || 'N/A' },
        certificadoVencimento: r.Vencimento_Certificado || '',
        senhas: { gov: r.Senha_GOV || '', nfse: senhasSplit[0] || '', email: senhasSplit[1] || '' }
      };
    }

    async function syncAllToGas(silent = false) {
      const url = document.getElementById('gas-url-input')?.value.trim() || AppState.config.gasUrl;
      if (!url) {
        if (!silent) showToast('Configure a URL /exec do Google Apps Script.', 'error');
        return;
      }

      const payload = {
        action: 'syncAll',
        data: {
          contabeis: (AppState.clientesContabeis || []).map(mapClientToSheetRow),
          gerais: (AppState.clientesGerais || []).map(mapClientToSheetRow),
          pagar: (AppState.contasPagar || []).map((i) => ({ ID: i.id, Data_Lancamento: i.vencimento, Fornecedor_Descricao: i.descricao, Categoria: i.categoria, Parcela: i.parcela, Vencimento: i.vencimento, Valor: i.valor, Status: i.status, Data_Pagamento: i.dataPagamento || '', Observacoes: '' })),
          receber: (AppState.contasReceber || []).map((i) => ({ ID: i.id, Data_Lancamento: i.vencimento, Cliente: i.cliente, Descricao_Servico: i.descricao, Parcela: i.parcela, Vencimento: i.vencimento, Valor: i.valor, Status: i.status, Data_Recebimento: i.dataRecebimento || '', Observacoes: '' })),
          tarefas: (AppState.tarefas || []).map((t) => ({ ID: t.id, Titulo: t.titulo, Area: t.area, Prioridade: t.prioridade, Prazo: t.prazo, Status: t.status, Responsavel: t.responsavel || '', Observacoes: '' })),
          licitacoes: (AppState.licitacoes || []).map((l) => ({ ID: l.id, Portal: l.portal, Numero_Edital: l.numeroEdital, Orgao: l.orgao, UF: l.uf, Modalidade: l.modalidade || 'Pregão Eletrônico', Objeto: l.objeto, Data_Abertura: l.dataAbertura, Valor_Estimado: l.valorEstimado, Link_Edital: l.link || '', Status_Acompanhamento: 'Monitorado' })),
          cursos: (AppState.cursos || []).map((c) => ({ ID: c.id, Curso: c.nome, Instituicao: c.instituicao, Carga_Horaria: c.cargaHoraria, Status: c.status })),
          estudos: (AppState.atividadesEstudo || []).map((a) => ({ ID: a.id, Data: a.data, Curso_ID: a.cursoId, Materia: '', Atividade: a.titulo, Status: a.status, Observacoes: '' })),
          pmi: (AppState.servicosPmi || []).map((s) => ({ ID: s.id, Data: s.data, Secretaria: s.secretaria, Servico: s.servico, Complemento: s.complemento || '', Valor: s.valor, Status_Pagamento: s.status, Numero_Empenho: s.empenho || '', Numero_NF: s.nf || '' })),
          os: (AppState.ordensServico || []).map((o) => ({ Numero_OS: o.id, Data_Abertura: o.data, Cliente: o.clienteNome, Telefone: o.telefone || '', Equipamento: o.equipamento, Defeito_Relatado: o.defeito || '', Servico_Executado: o.servicoExecutado || '', Valor: o.valor, Status: o.status, Data_Conclusao: '' })),
          usuarios: (AppState.users || []).map((u) => ({ ID: u.id, Usuario: u.username, Nome_Completo: u.name, Senha_Hash: u.password, Perfil: u.role, Ativo: 'Sim' }))
        }
      };

      try {
        const res = await fetch(url, { method: 'POST', body: JSON.stringify(payload) });
        const json = await res.json();
        AppState.config.lastSyncAt = new Date().toISOString();
        AppState.config.lastSyncMessage = json.message || 'Dados enviados para o Google Sheets.';
        saveState();
        if (ActiveRoute === 'administracao') renderRoute('administracao');
        if (!silent) showToast('Sincronização com Google Sheets concluída!');
      } catch (err) {
        if (!silent) showToast('Erro ao enviar dados para a planilha.', 'error');
      }
    }

    async function pullAllFromGas() {
      const url = document.getElementById('gas-url-input')?.value.trim() || AppState.config.gasUrl;
      if (!url) return showToast('Configure a URL /exec do Google Apps Script.', 'error');
      try {
        const res = await fetch(`${url}?action=readAll`);
        const json = await res.json();
        if (!json.success || !json.data) throw new Error(json.error || 'Resposta inválida');

        const d = json.data;
        if (Array.isArray(d.contabeis) && d.contabeis.length) AppState.clientesContabeis = d.contabeis.map(mapSheetRowToClient);
        if (Array.isArray(d.gerais) && d.gerais.length) AppState.clientesGerais = d.gerais.map(mapSheetRowToClient);
        if (Array.isArray(d.pagar) && d.pagar.length) AppState.contasPagar = d.pagar.map((i) => ({ id: i.ID, descricao: i.Fornecedor_Descricao, categoria: i.Categoria, parcela: i.Parcela, vencimento: i.Vencimento, valor: Number(i.Valor || 0), status: i.Status, dataPagamento: i.Data_Pagamento }));
        if (Array.isArray(d.receber) && d.receber.length) AppState.contasReceber = d.receber.map((i) => ({ id: i.ID, cliente: i.Cliente, descricao: i.Descricao_Servico, parcela: i.Parcela, vencimento: i.Vencimento, valor: Number(i.Valor || 0), status: i.Status, dataRecebimento: i.Data_Recebimento }));
        if (Array.isArray(d.tarefas) && d.tarefas.length) AppState.tarefas = d.tarefas.map((t) => ({ id: t.ID, titulo: t.Titulo, area: t.Area, prioridade: t.Prioridade, prazo: t.Prazo, status: t.Status, responsavel: t.Responsavel }));
        if (Array.isArray(d.pmi) && d.pmi.length) AppState.servicosPmi = d.pmi.map((s) => ({ id: s.ID, data: s.Data, secretaria: s.Secretaria, servico: s.Servico, complemento: s.Complemento, valor: Number(s.Valor || 0), status: s.Status_Pagamento, empenho: s.Numero_Empenho, nf: s.Numero_NF }));
        if (Array.isArray(d.os) && d.os.length) AppState.ordensServico = d.os.map((o) => ({ id: o.Numero_OS, data: o.Data_Abertura, clienteNome: o.Cliente, telefone: o.Telefone, equipamento: o.Equipamento, defeito: o.Defeito_Relatado, servicoExecutado: o.Servico_Executado, valor: Number(o.Valor || 0), status: o.Status }));

        AppState.config.lastSyncAt = new Date().toISOString();
        AppState.config.lastSyncMessage = 'Dados importados da planilha com sucesso.';
        saveState();
        renderRoute('administracao');
        showToast('Dados puxados da nuvem com sucesso!');
      } catch (err) {
        showToast('Erro ao puxar dados do Google Sheets.', 'error');
      }
    }

    function openGasCodeModal() {
      openModal(
        'Instruções de Implantação — Codigo.gs',
        `
          <p class="text-xs text-slate-600">Cole o arquivo <strong>Codigo.gs</strong> gerado na conversa em <em>Extensões &gt; Apps Script</em> da sua planilha Google, implante como <strong>App da Web</strong> (<em>Executar como: Eu</em> | <em>Quem pode acessar: Qualquer pessoa</em>) e informe a URL terminada em <code>/exec</code> no campo da tela de Administração.</p>
        `
      );
    }

    function exportFullBackupJSON() {
      const blob = new Blob([JSON.stringify(AppState, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `backup_contech_erp_${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function restoreFullBackupJSON(input) {
      const file = input.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const parsed = JSON.parse(reader.result);
          AppState = { ...createInitialState(), ...parsed };
          saveState();
          renderRoute(ActiveRoute);
          showToast('Backup JSON restaurado com sucesso!');
        } catch (e) {
          showToast('Arquivo JSON inválido.', 'error');
        }
      };
      reader.readAsText(file);
    }

    function openLgpdModal() {
      openModal(
        'Governança de Dados & Conformidade LGPD (Lei nº 13.709/2018)',
        `
          <div class="space-y-3 text-xs text-slate-700 leading-relaxed">
            <p><strong>1. Finalidade e Base Legal:</strong> Os dados pessoais e fiscais tratados no <strong>CONTECH ERP</strong> destinam-se exclusivamente à execução de contratos contábeis, cumprimento de obrigações legais/regulatórias junto aos órgãos fazendários e suporte técnico de TI (Art. 7º, II e V da LGPD).</p>
            <p><strong>2. Armazenamento e Controle:</strong> Os registros são armazenados localmente no navegador do operador e sincronizados sob demanda com a planilha institucional protegida da CONTECH Contabilidade &amp; Informática.</p>
            <p><strong>3. Segurança de Credenciais:</strong> O acesso ao painel exige autenticação individualizada, recomenda-se o bloqueio da sessão ao ausentar-se da estação de trabalho e a realização periódica de backups criptografados/restritos.</p>
          </div>
        `
      );
    }

    // =========================================================================
    // INICIALIZAÇÃO
    // =========================================================================
    document.getElementById('login-logo-slot').innerHTML = getContechLogoSVG(false);
    document.getElementById('sidebar-logo-slot').innerHTML = getContechLogoSVG(true);
    syncAuthScreen();
  </script>
