    let reportFilter = { type: 'fluxo', startDate: '', endDate: '', status: '', secretaria: '' };

    function buildReportDataset() {
      const { type, startDate, endDate, status, secretaria } = reportFilter;
      const inRange = (d) => (!startDate || (d && d >= startDate)) && (!endDate || (d && d <= endDate));

      if (type === 'fluxo') {
        const rec = (AppState.contasReceber || []).filter((i) => inRange(i.vencimento)).map((i) => ({ tipo: 'Receita', desc: `${i.cliente} — ${i.descricao}`, data: i.vencimento, status: i.status, valor: Number(i.valor || 0) }));
        const pag = (AppState.contasPagar || []).filter((i) => inRange(i.vencimento)).map((i) => ({ tipo: 'Despesa', desc: `${i.descricao} (${i.categoria})`, data: i.vencimento, status: i.status, valor: -Number(i.valor || 0) }));
        const all = [...rec, ...pag].filter((x) => !status || x.status.toLowerCase().includes(status.toLowerCase()));
        const saldo = all.reduce((s, x) => s + x.valor, 0);
        return {
          title: 'Relatório de Fluxo Financeiro Consolidado',
          headers: ['Tipo', 'Descrição', 'Vencimento', 'Status', 'Valor'],
          rows: all.map((x) => [x.tipo, x.desc, formatDateBR(x.data), x.status, formatCurrency(x.valor)]),
          rawRows: all.map((x) => [x.tipo, x.desc, x.data, x.status, x.valor]),
          summary: `Saldo Líquido: ${formatCurrency(saldo)} (${all.length} lançamentos)`
        };
      }

      if (type === 'receber') {
        const list = (AppState.contasReceber || []).filter((i) => inRange(i.vencimento) && (!status || i.status.toLowerCase().includes(status.toLowerCase())));
        const total = list.reduce((s, i) => s + Number(i.valor || 0), 0);
        return {
          title: 'Relatório de Contas a Receber',
          headers: ['Cliente', 'Descrição', 'Parcela', 'Vencimento', 'Status', 'Valor'],
          rows: list.map((i) => [i.cliente, i.descricao, i.parcela, formatDateBR(i.vencimento), i.status, formatCurrency(i.valor)]),
          rawRows: list.map((i) => [i.cliente, i.descricao, i.parcela, i.vencimento, i.status, i.valor]),
          summary: `Total: ${formatCurrency(total)} (${list.length} registros)`
        };
      }

      if (type === 'pagar') {
        const list = (AppState.contasPagar || []).filter((i) => inRange(i.vencimento) && (!status || i.status.toLowerCase().includes(status.toLowerCase())));
        const total = list.reduce((s, i) => s + Number(i.valor || 0), 0);
        return {
          title: 'Relatório de Contas a Pagar',
          headers: ['Descrição', 'Categoria', 'Parcela', 'Vencimento', 'Status', 'Valor'],
          rows: list.map((i) => [i.descricao, i.categoria, i.parcela, formatDateBR(i.vencimento), i.status, formatCurrency(i.valor)]),
          rawRows: list.map((i) => [i.descricao, i.categoria, i.parcela, i.vencimento, i.status, i.valor]),
          summary: `Total: ${formatCurrency(total)} (${list.length} registros)`
        };
      }

      if (type === 'contabeis' || type === 'gerais') {
        const list = type === 'contabeis' ? AppState.clientesContabeis || [] : AppState.clientesGerais || [];
        return {
          title: type === 'contabeis' ? 'Relatório de Clientes Contábeis' : 'Relatório de Clientes Gerais & TI',
          headers: ['ID', 'Nome / Razão Social', 'CNPJ / CPF', 'Regime', 'Celular', 'Certificado'],
          rows: list.map((c) => [c.id, c.nomeRazao, c.cnpj || c.cpf, c.regimeTributario, c.celular, formatDateBR(c.certificadoVencimento)]),
          rawRows: list.map((c) => [c.id, c.nomeRazao, c.cnpj || c.cpf, c.regimeTributario, c.celular, c.certificadoVencimento]),
          summary: `Total de Clientes: ${list.length}`
        };
      }

      if (type === 'certificados') {
        const list = getAllCertificates().filter((c) => inRange(c.vencimento));
        return {
          title: 'Relatório de Certificados Digitais',
          headers: ['Origem', 'Cliente', 'Documento', 'Vencimento', 'Celular'],
          rows: list.map((c) => [c.tipo, c.cliente, c.doc, formatDateBR(c.vencimento), c.celular]),
          rawRows: list.map((c) => [c.tipo, c.cliente, c.doc, c.vencimento, c.celular]),
          summary: `Total Monitorados: ${list.length}`
        };
      }

      if (type === 'pmi') {
        const list = (AppState.servicosPmi || []).filter((s) => inRange(s.data) && (!secretaria || s.secretaria.toLowerCase().includes(secretaria.toLowerCase())));
        const total = list.reduce((acc, s) => acc + Number(s.valor || 0), 0);
        return {
          title: 'Relatório de Serviços PMI — Prefeitura de Itaporanga',
          headers: ['Data', 'Secretaria', 'Serviço', 'Status', 'Valor'],
          rows: list.map((s) => [formatDateBR(s.data), s.secretaria, s.servico, s.status, formatCurrency(s.valor)]),
          rawRows: list.map((s) => [s.data, s.secretaria, s.servico, s.status, s.valor]),
          summary: `Total Serviços PMI: ${formatCurrency(total)} (${list.length} serviços)`
        };
      }

      if (type === 'os') {
        const list = (AppState.ordensServico || []).filter((o) => inRange(o.data) && (!status || o.status.toLowerCase().includes(status.toLowerCase())));
        const total = list.reduce((acc, o) => acc + Number(o.valor || 0), 0);
        return {
          title: 'Relatório de Ordens de Serviço (OS)',
          headers: ['Nº OS', 'Data', 'Cliente', 'Equipamento', 'Status', 'Valor'],
          rows: list.map((o) => [o.id, formatDateBR(o.data), o.clienteNome, o.equipamento, o.status, formatCurrency(o.valor)]),
          rawRows: list.map((o) => [o.id, o.data, o.clienteNome, o.equipamento, o.status, o.valor]),
          summary: `Total Ordens de Serviço: ${formatCurrency(total)} (${list.length} OS)`
        };
      }

      if (type === 'tarefas') {
        const list = (AppState.tarefas || []).filter((t) => inRange(t.prazo) && (!status || t.status.toLowerCase().includes(status.toLowerCase())));
        return {
          title: 'Relatório de Tarefas & Prazos',
          headers: ['Título', 'Área', 'Prioridade', 'Prazo', 'Responsável', 'Status'],
          rows: list.map((t) => [t.titulo, t.area, t.prioridade, formatDateBR(t.prazo), t.responsavel || '—', t.status]),
          rawRows: list.map((t) => [t.titulo, t.area, t.prioridade, t.prazo, t.responsavel || '', t.status]),
          summary: `Total de Tarefas: ${list.length}`
        };
      }

      const list = (AppState.atividadesEstudo || []).filter((a) => inRange(a.data) && (!status || a.status.toLowerCase().includes(status.toLowerCase())));
      return {
        title: 'Relatório de Estudos & Atividades',
        headers: ['Data', 'Curso', 'Atividade', 'Status'],
        rows: list.map((a) => {
          const c = (AppState.cursos || []).find((x) => x.id === a.cursoId);
          return [formatDateBR(a.data), c ? c.nome : 'Geral', a.titulo, a.status];
        }),
        rawRows: list.map((a) => [a.data, a.cursoId, a.titulo, a.status]),
        summary: `Total de Atividades de Estudo: ${list.length}`
      };
    }

