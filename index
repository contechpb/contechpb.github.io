        `
      );

      document.getElementById('user-form').onsubmit = (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const rec = {
          id: item ? item.id : generateId('USR'),
          name: fd.get('name').trim(),
          username: fd.get('username').trim(),
          password: fd.get('password'),
          role: fd.get('role')
        };
        if (item) {
          const idx = AppState.users.findIndex((x) => x.id === item.id);
          if (idx >= 0) AppState.users[idx] = rec;
        } else {
          AppState.users.push(rec);
