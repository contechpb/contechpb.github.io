            <div><label class="font-semibold">Prazo *</label><input type="date" name="prazo" required value="${escapeHTML(t.prazo)}" class="w-full mt-1 px-3 py-2 rounded-xl border" /></div>
            <div><label class="font-semibold">Responsável</label><input name="responsavel" value="${escapeHTML(t.responsavel || '')}" class="w-full mt-1 px-3 py-2 rounded-xl border" /></div>
