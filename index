        `,
        `
          <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl bg-slate-200 text-xs font-bold cursor-pointer">Cancelar</button>
          <button type="submit" form="tarefa-form" class="px-4 py-2 rounded-xl bg-accent-500 text-white text-xs font-bold cursor-pointer">Salvar Tarefa</button>
        `
      );

      document.getElementById('tarefa-form').onsubmit = (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const rec = {
          id: item ? item.id : generateId('TAR'),
          titulo: fd.get('titulo').trim(),
          area: fd.get('area'),
          prioridade: fd.get('prioridade'),
          prazo: fd.get('prazo'),
          status: item ? item.status : 'Pendente',
          responsavel: fd.get('responsavel').trim()
        };
        if (item) {
          const idx = AppState.tarefas.findIndex((x) => x.id === item.id);
          if (idx >= 0) AppState.tarefas[idx] = rec;
        } else {
          AppState.tarefas.unshift(rec);
        }
        saveState();
        closeModal();
        renderRoute('tarefas');
        showToast('Tarefa salva!');
      };
    }

    function updateTarefaStatus(id, status) {
      const t = (AppState.tarefas || []).find((x) => x.id === id);
      if (t) {
        t.status = status;
        saveState();
        renderRoute('tarefas');
      }
    }

    function deleteTarefa(id) {
      askConfirm('Excluir Tarefa', 'Deseja remover esta tarefa?', () => {
        AppState.tarefas = AppState.tarefas.filter((x) => x.id !== id);
        saveState();
        renderRoute('tarefas');
      });
    }

    // =========================================================================
    // 7. BUSCA & MONITORAMENTO DE LICITAÇÕES (MULTI-PORTAL APIs)
    // =========================================================================
    let licitacoesRemoteResults = [];
    let licitacoesSourceStatus = [];
    let licitacoesLoading = false;
    let licFilter = { query: '', uf: 'PB', portal: '', maxDate: '', minVal: '', maxVal: '', sort: 'asc' };

    async function searchAllTenderPortals() {
      licitacoesLoading = true;
      licitacoesSourceStatus = [];
      renderRoute('licitacoes');

      const uf = (licFilter.uf || '').trim().toUpperCase();
      const q = (licFilter.query || '').trim();
      const collected = [];

      // 1. PNCP - Propostas Abertas
      try {
        const dFin = new Date(Date.now() + 90 * 86400000).toISOString().slice(0, 10).replace(/-/g, '');
        const ufParam = uf ? `&uf=${encodeURIComponent(uf)}` : '';
        const res = await fetch(`https://pncp.gov.br/api/consulta/v1/contratacoes/proposta?dataFinal=${dFin}${ufParam}&pagina=1&tamanhoPagina=50`);
        if (res.ok) {
          const data = await res.json();
          const items = data.data || [];
          items.forEach((it) => {
            const cnpj = it.orgaoEntidade?.cnpj || '';
            const ano = it.anoCompra || '';
            const seq = it.sequencialCompra || '';
            collected.push({
              id: it.numeroControlePNCP || generateId('PNCP'),
              numeroEdital: `${it.numeroCompra || 'S/N'}/${ano}`,
              orgao: it.orgaoEntidade?.razaoSocial || 'Órgão Público',
              municipio: it.unidadeOrgao?.municipioNome || '',
              portal: 'PNCP (Propostas Abertas)',
              uf: it.unidadeOrgao?.ufSigla || uf || 'BR',
              modalidade: it.modalidadeNome || 'Pregão Eletrônico',
              objeto: it.objetoCompra || '',
              valorEstimado: Number(it.valorTotalEstimado || 0),
              dataAbertura: String(it.dataAberturaProposta || it.dataPublicacaoPncp || '').slice(0, 10),
              link: cnpj && ano && seq ? `https://pncp.gov.br/app/editais/${cnpj}/${ano}/${seq}` : 'https://pncp.gov.br/app/editais'
            });
          });
          licitacoesSourceStatus.push({ name: 'PNCP Propostas', ok: true, count: items.length });
        } else {
          licitacoesSourceStatus.push({ name: 'PNCP Propostas', ok: false, count: 0 });
        }
      } catch (e) {
        licitacoesSourceStatus.push({ name: 'PNCP Propostas', ok: false, count: 0 });
      }

      // 2. Querido Diário (Diários Oficiais Municipais)
      try {
        const term = encodeURIComponent(q || 'pregão eletrônico licitação');
        const resQD = await fetch(`https://queridodiario.ok.org.br/api/gazettes?querystring=${term}&size=20`);
        if (resQD.ok) {
          const dataQD = await resQD.json();
          const gazettes = dataQD.gazettes || [];
          gazettes.forEach((g, idx) => {
            if (uf && g.state_code && g.state_code.toUpperCase() !== uf) return;
            collected.push({
              id: `QD-${g.territory_id || idx}-${g.date || idx}`,
              numeroEdital: `Diário Oficial (${formatDateBR(g.date)})`,
              orgao: `Município de ${g.territory_name || 'N/I'} - ${g.state_code || ''}`,
              municipio: g.territory_name || '',
              portal: 'Querido Diário (DOM)',
              uf: g.state_code || uf || 'BR',
              modalidade: 'Publicação Oficial',
              objeto: (g.excerpts && g.excerpts[0] ? g.excerpts[0].replace(/<[^>]+>/g, '') : 'Aviso de licitação publicado em Diário Oficial.'),
              valorEstimado: 0,
              dataAbertura: String(g.date || '').slice(0, 10),
              link: g.url || 'https://queridodiario.ok.org.br'
            });
          });
          licitacoesSourceStatus.push({ name: 'Diários Oficiais', ok: true, count: gazettes.length });
        }
      } catch (e) {
        licitacoesSourceStatus.push({ name: 'Diários Oficiais', ok: false, count: 0 });
      }

      // 3. Google Apps Script (/exec?action=licitacoes) se configurado
      if (AppState.config?.gasUrl) {
        try {
          const url = `${AppState.config.gasUrl}?action=licitacoes&uf=${encodeURIComponent(uf)}&q=${encodeURIComponent(q)}`;
          const resGas = await fetch(url);
          if (resGas.ok) {
            const jsonGas = await resGas.json();
            if (jsonGas.success && Array.isArray(jsonGas.items)) {
              collected.push(...jsonGas.items);
              licitacoesSourceStatus.push({ name: 'Apps Script / TCE-PB', ok: true, count: jsonGas.items.length });
            }
          }
        } catch (e) {
          licitacoesSourceStatus.push({ name: 'Apps Script / TCE-PB', ok: false, count: 0 });
        }
      }

      const map = new Map();
      collected.forEach((item) => map.set(item.id, item));
      licitacoesRemoteResults = Array.from(map.values());
      licitacoesLoading = false;
      renderRoute('licitacoes');
      showToast(`${licitacoesRemoteResults.length} edital(is) localizado(s) nos portais.`);
    }

    function renderLicitacoes(container) {
      const combined = [...(AppState.licitacoes || []), ...licitacoesRemoteResults];
      const dedup = Array.from(new Map(combined.map((x) => [x.id, x])).values());

      const filtered = dedup
        .filter((l) => {
          const q = licFilter.query.trim().toLowerCase();
          if (q && ![l.numeroEdital, l.orgao, l.objeto, l.municipio, l.portal].filter(Boolean).some((v) => String(v).toLowerCase().includes(q))) return false;
          if (licFilter.uf && l.uf && l.uf.toUpperCase() !== licFilter.uf.toUpperCase()) return false;
          if (licFilter.portal && l.portal !== licFilter.portal) return false;
          if (licFilter.maxDate && l.dataAbertura && l.dataAbertura > licFilter.maxDate) return false;
          if (licFilter.minVal && Number(l.valorEstimado || 0) < Number(licFilter.minVal)) return false;
          if (licFilter.maxVal && Number(l.valorEstimado || 0) > Number(licFilter.maxVal)) return false;
          return true;
        })
        .sort((a, b) =>
          licFilter.sort === 'asc'
            ? String(a.dataAbertura || '').localeCompare(String(b.dataAbertura || ''))
            : String(b.dataAbertura || '').localeCompare(String(a.dataAbertura || ''))
        );

      const portals = Array.from(new Set(dedup.map((x) => x.portal).filter(Boolean)));

      container.innerHTML = `
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-navy-900">Busca &amp; Monitoramento de Licitações</h2>
            <p class="text-xs sm:text-sm text-slate-600">Consulta integrada ao PNCP, Diários Oficiais, TCE-PB / Apps Script e base salva.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" onclick="searchAllTenderPortals()" class="px-4 py-2 rounded-xl bg-accent-500 hover:bg-accent-600 text-white text-xs font-bold cursor-pointer">
              ${licitacoesLoading ? 'Consultando APIs...' : 'Buscar nas APIs dos Portais'}
            </button>
            <button type="button" onclick="openManualLicitacaoModal()" class="px-3.5 py-2 rounded-xl bg-navy-800 hover:bg-navy-700 text-white text-xs font-semibold cursor-pointer">
              + Incluir Manual
            </button>
            <button type="button" onclick="exportLicitacoesCSV()" class="px-3.5 py-2 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-semibold cursor-pointer">
              Exportar CSV
            </button>
          </div>
        </div>

        ${
          licitacoesSourceStatus.length
            ? `<div class="flex flex-wrap gap-2 text-xs">
                ${licitacoesSourceStatus.map((s) => `<span class="px-3 py-1 rounded-full font-semibold ${s.ok ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-700'}">${escapeHTML(s.name)}: ${s.ok ? s.count + ' registro(s)' : 'indisponível'}</span>`).join('')}
              </div>`
            : ''
        }

        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 text-xs">
          <input type="text" value="${escapeHTML(licFilter.query)}" oninput="licFilter.query = this.value; renderRoute('licitacoes');" placeholder="Palavra-chave / Órgão..." class="lg:col-span-2 px-3 py-2 rounded-xl border" />
          <input type="text" maxlength="2" value="${escapeHTML(licFilter.uf)}" oninput="licFilter.uf = this.value.toUpperCase(); renderRoute('licitacoes');" placeholder="UF (ex: PB)" class="px-3 py-2 rounded-xl border uppercase" />
          <select onchange="licFilter.portal = this.value; renderRoute('licitacoes');" class="px-3 py-2 rounded-xl border bg-white">
            <option value="">Todos os Portais</option>
            ${portals.map((p) => `<option value="${escapeHTML(p)}" ${licFilter.portal === p ? 'selected' : ''}>${escapeHTML(p)}</option>`).join('')}
          </select>
          <input type="date" value="${escapeHTML(licFilter.maxDate)}" onchange="licFilter.maxDate = this.value; renderRoute('licitacoes');" title="Data máxima de abertura" class="px-3 py-2 rounded-xl border" />
          <select onchange="licFilter.sort = this.value; renderRoute('licitacoes');" class="px-3 py-2 rounded-xl border bg-white">
            <option value="asc" ${licFilter.sort === 'asc' ? 'selected' : ''}>Recentes → Longe</option>
            <option value="desc" ${licFilter.sort === 'desc' ? 'selected' : ''}>Longe → Recentes</option>
          </select>
        </div>

        <div class="space-y-3">
          ${
            filtered.slice(0, 60).map((l) => {
              const isSaved = (AppState.licitacoes || []).some((x) => x.id === l.id);
              return `
                <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
                  <div class="space-y-1">
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                      <span class="px-2.5 py-0.5 rounded-full bg-navy-900 text-white font-bold">${escapeHTML(l.portal)}</span>
                      <span class="font-bold text-accent-600">${escapeHTML(l.numeroEdital)}</span>
                      <span class="text-slate-500">• ${escapeHTML(l.uf)} • Abertura: <strong>${formatDateBR(l.dataAbertura)}</strong></span>
                    </div>
                    <div class="text-sm font-extrabold text-navy-900">${escapeHTML(l.orgao)}</div>
                    <p class="text-xs text-slate-600 line-clamp-2">${escapeHTML(l.objeto)}</p>
                    <div class="text-xs font-bold text-emerald-700">Valor Estimado: ${formatCurrency(l.valorEstimado)}</div>
                  </div>
                  <div class="flex flex-wrap gap-2 shrink-0 text-xs">
                    ${!isSaved ? `<button type="button" onclick="saveRemoteLicitacao('${escapeHTML(l.id)}')" class="px-3 py-1.5 rounded-xl bg-navy-100 hover:bg-navy-200 text-navy-900 font-bold cursor-pointer">Salvar na Base</button>` : `<span class="px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-800 font-bold">Salvo</span>`}
                    <button type="button" onclick="convertLicitacaoToTask('${escapeHTML(l.id)}')" class="px-3 py-1.5 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-900 font-bold cursor-pointer">Criar Tarefa</button>
                    ${l.link ? `<a href="${escapeHTML(l.link)}" target="_blank" rel="noopener" class="px-3 py-1.5 rounded-xl bg-accent-500 hover:bg-accent-600 text-white font-bold">Abrir Edital</a>` : ''}
                  </div>
                </div>
              `;
            }).join('') || `<div class="bg-white rounded-2xl p-8 text-center text-xs text-slate-500 border">Nenhuma licitação encontrada. Clique em <strong>Buscar nas APIs dos Portais</strong> para consultar em tempo real.</div>`
          }
        </div>
      `;
    }

    function saveRemoteLicitacao(id) {
      const found = licitacoesRemoteResults.find((x) => x.id === id);
      if (!found) return;
      if (!(AppState.licitacoes || []).some((x) => x.id === id)) {
        AppState.licitacoes.unshift(found);
        saveState();
        renderRoute('licitacoes');
        showToast('Edital salvo na base local!');
      }
    }

    function convertLicitacaoToTask(id) {
      const all = [...(AppState.licitacoes || []), ...licitacoesRemoteResults];
      const found = all.find((x) => x.id === id);
      if (!found) return;
      openTarefaModal(null, {
        titulo: `Participar Licitação: ${found.numeroEdital} — ${found.orgao}`,
        area: 'Licitações',
        prioridade: 'Alta',
        prazo: found.dataAbertura || addDaysISO(5),
        responsavel: 'Setor Licitações'
      });
    }

