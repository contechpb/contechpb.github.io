          <button type="button" id="confirm-yes-btn" class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold cursor-pointer">Confirmar</button>
        `
      );
      document.getElementById('confirm-yes-btn').onclick = () => {
