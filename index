          inscricaoEstadual: fd.get('inscricaoEstadual').trim(),
          inscricaoMunicipal: fd.get('inscricaoMunicipal').trim(),
          dataAbertura: fd.get('dataAbertura'),
          regimeTributario: fd.get('regimeTributario'),
          capitalSocial: Number(fd.get('capitalSocial') || 0),
          producoes: fd.getAll('producoes'),
          parcelamentos: fd.getAll('parcelamentos'),
          obrigacoes: { EFD: fd.get('EFD'), MIT: fd.get('MIT'), DEFIS: fd.get('DEFIS'), DASN: fd.get('DASN') },
          certificadoVencimento: fd.get('certificadoVencimento'),
          senhas: { gov: fd.get('senhaGov'), nfse: fd.get('senhaNfse'), email: fd.get('senhaEmail') }
        };

        const targetArr = kind === 'contabeis' ? AppState.clientesContabeis : AppState.clientesGerais;
        if (item) {
          const idx = targetArr.findIndex((x) => x.id === editId);
