                  return `
                    <tr class="hover:bg-navy-50/50">
                      <td class="py-3 px-3.5">
                        <div class="font-bold text-navy-900">${escapeHTML(isPagar ? item.descricao : item.cliente)}</div>
                        <div class="text-[11px] text-slate-500">${escapeHTML(isPagar ? item.categoria : item.descricao)}</div>
                      </td>
                      <td class="py-3 px-3.5 font-semibold">${escapeHTML(item.parcela || '1/1')}</td>
                      <td class="py-3 px-3.5">${formatDateBR(item.vencimento)}</td>
                      <td class="py-3 px-3.5 font-bold text-navy-900">${formatCurrency(item.valor)}</td>
                      <td class="py-3 px-3.5">
                        <span class="px-2.5 py-0.5 rounded-full font-bold ${isDone ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-800'}">${escapeHTML(item.status)}</span>
                      </td>
                      <td class="py-3 px-3.5 text-right whitespace-nowrap space-x-1">
                        ${
                          !isDone
                            ? `<button type="button" onclick="toggleFinanceiroStatus('${mode}', '${item.id}', '${doneStatus}')" class="px-2.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold cursor-pointer">${isPagar ? 'Baixar Pago' : 'Baixar Recebido'}</button>`
                            : `<button type="button" onclick="toggleFinanceiroStatus('${mode}', '${item.id}', '${openStatus}')" class="px-2.5 py-1.5 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-900 font-semibold cursor-pointer">Estornar</button>`
                        }
                        <button type="button" onclick="deleteFinanceiroItem('${mode}', '${item.id}')" class="px-2.5 py-1.5 rounded-lg bg-red-100 hover:bg-red-200 text-red-700 font-semibold cursor-pointer">Excluir</button>
                      </td>
                    </tr>
                  `;
                }).join('') ||
                `<tr><td colspan="6" class="py-6 text-center text-slate-500">${emptyMessage}</td></tr>`
              }
            </tbody>
          </table>
        </div>
      `;

      container.innerHTML = `
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-navy-900">${isPagar ? 'Contas a Pagar' : 'Contas a Receber'}</h2>
            <p class="text-xs sm:text-sm text-slate-600">${
              isPagar
                ? 'Controle de despesas, parcelamento automático mensal (1/N), baixas e estornos.'
                : 'Controle de honorários e serviços por cliente, parcelamento automático mensal e recebimentos.'
            }</p>
          </div>
          <button type="button" onclick="openLancamentoFinanceiroModal('${mode}')" class="px-4 py-2.5 rounded-xl bg-accent-500 hover:bg-accent-600 text-white text-xs font-semibold cursor-pointer">
            + ${isPagar ? 'Nova Despesa' : 'Novo Lançamento'}
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm">
            <div class="text-xs font-semibold text-slate-500">Total Pendente / Em Aberto</div>
            <div class="text-2xl font-extrabold text-accent-600 mt-1">${formatCurrency(totalPendente)}</div>
          </div>
          <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm">
